# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/day5_tasks

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Bcrypt
BCRYPT_ROUNDS=10

# File uploads
UPLOAD_MAX_MB=5

# Cache TTL in seconds
CACHE_TTL_SECONDS=30

# Email — leave empty to use Ethereal (fake SMTP for dev/testing)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@tasks.local
