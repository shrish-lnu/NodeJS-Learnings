# Server
NODE_ENV=development
PORT=3000

# MongoDB — matches docker-compose.yml defaults
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/day4_tasks?authSource=admin

# JWT secrets —  (e.g. openssl rand -hex 64)
JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars-long

# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

BCRYPT_ROUNDS=10

# CORS: comma-separated allowed origins for production
